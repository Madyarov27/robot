# Required
OPENAI_API_KEY=sk-...

# Models (defaults shown). Swap to whisper-1 / tts-1 if a model is unavailable.
# ROBOT_CHAT_MODEL=gpt-4.1-mini
# ROBOT_STT_MODEL=gpt-4o-mini-transcribe
# ROBOT_TTS_MODEL=gpt-4o-mini-tts
# ROBOT_TTS_VOICE=ballad

# Force a language for transcription (en / ru / uz). Blank = autodetect.
# ROBOT_LANGUAGE=

# Audio devices — index or name substring. Blank = system default.
# On the Pi, run `python check_audio.py` to see the list, then set these.
# ROBOT_INPUT_DEVICE=
# ROBOT_OUTPUT_DEVICE=

# Voice-activity tuning. Raise the multiplier in a noisy room, lower it if the
# robot never hears you.
# ROBOT_NOISE_MULTIPLIER=3.5
# ROBOT_SILENCE_HANG_S=0.9
